---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, experience, links } from "../site";

const all = await getCollection("projects", ({ data }) => import.meta.env.DEV || !data.draft);
const sorted = all.sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter((p) => p.data.featured);
const rest = sorted.filter((p) => !p.data.featured);
---

<Base>
  {/* Above the fold: who, what, best work, how to reach you. Nothing else.
      Visitors decide in under 30 seconds — see PLAN.md §1. */}
  <section class="py-12">
    <h1 class="text-3xl font-medium tracking-tight">{site.name}</h1>
    <p class="mt-3 text-lg text-muted">{site.tagline}</p>
    <p class="mt-6 max-w-prose">{site.intro}</p>
    <div class="mt-6 flex flex-wrap gap-4 text-sm">
      <a href={`mailto:${site.email}`} class="text-accent hover:underline">{site.email}</a>
      <a href={links.github} class="text-accent hover:underline">GitHub</a>
      <a href={links.linkedin} class="text-accent hover:underline">LinkedIn</a>
      {site.resume && <a href={site.resume} class="text-accent hover:underline">Résumé (PDF)</a>}
    </div>
  </section>

  <section id="work" class="py-12">
    <h2 class="text-sm uppercase tracking-widest text-muted">Work</h2>
    <ol class="mt-4">
      {experience.map((job) => (
        <li class="border-t border-line py-5">
          <div class="flex items-baseline justify-between gap-4">
            <p class="font-medium">{job.role}, {job.company}</p>
            <span class="shrink-0 text-sm text-muted">{job.period}</span>
          </div>
          <p class="mt-1 text-muted">{job.note}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="projects" class="py-12">
    <h2 class="text-sm uppercase tracking-widest text-muted">Selected projects</h2>
    {featured.map((project) => <ProjectCard project={project} />)}

    {rest.length > 0 && (
      <>
        <h2 class="mt-12 text-sm uppercase tracking-widest text-muted">Also</h2>
        <ul class="mt-2">
          {rest.map((p) => (
            <li class="border-t border-line py-3 text-sm">
              <a href={`/projects/${p.id}`} class="hover:text-accent">{p.data.title}</a>
              <span class="text-muted"> — {p.data.blurb}</span>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <section id="about" class="py-12">
    <h2 class="text-sm uppercase tracking-widest text-muted">About</h2>
    <p class="mt-4 max-w-prose text-muted">TODO — see PLAN.md §2. Short, specific, first person.</p>
  </section>
</Base>
