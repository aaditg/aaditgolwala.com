---
import Tile from "./Tile.astro";
import { site } from "../site";

// Server-rendered once at build so the tile is never empty; the script keeps
// it honest after that.
const fmt = new Intl.DateTimeFormat("en-US", {
  hour: "numeric",
  minute: "2-digit",
  timeZone: site.timeZone,
});
const initial = fmt.format(new Date());
---

<Tile cols={1} label="Local time">
  <p class="mt-auto font-mono text-2xl tabular-nums tracking-tight" data-clock data-tz={site.timeZone}>
    {initial}
  </p>
  <p class="mt-1 text-xs text-muted">{site.location}</p>
</Tile>

<script>
  const el = document.querySelector<HTMLElement>("[data-clock]");
  if (el) {
    const fmt = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: el.dataset.tz,
    });
    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    // Align to the next minute boundary, then every minute.
    setTimeout(() => { tick(); setInterval(tick, 60_000); }, 60_000 - (Date.now() % 60_000));
  }
</script>
