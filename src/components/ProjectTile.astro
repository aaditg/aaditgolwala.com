---
import type { CollectionEntry } from "astro:content";
import Tile from "./Tile.astro";
import StatusPill from "./StatusPill.astro";
import MacroChart from "./MacroChart.astro";

// lead   → 4×2 with the figure. Exactly one per page.
// large  → 2×2. Second-ranked.
// normal → 2×1. Everything else that is featured.
interface Props {
  project: CollectionEntry<"projects">;
  size: "lead" | "large" | "normal";
  id?: string;
}

const { project, size, id } = Astro.props;
const { title, blurb, period, status, hardPart, metrics, chart, repo, demo, stack } = project.data;
const href = `/projects/${project.id}`;
const cols = size === "lead" ? 4 : 2;
const rows = size === "normal" ? 1 : 2;
---

<Tile cols={cols} rows={rows} id={id} href={href} label={size === "lead" ? "Lead project" : "Project"}>
  <div class:list={["flex min-w-0 flex-1 gap-6", size === "lead" && "md:flex-row", "flex-col"]}>
    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h3 class:list={["font-semibold tracking-tight", size === "lead" ? "text-xl" : "text-[17px]"]}>
          {title}
        </h3>
        <StatusPill status={status} />
      </div>

      <p class:list={["mt-2 text-muted", size === "normal" ? "text-sm" : "text-[15px]"]}>{blurb}</p>

      {size !== "normal" && hardPart && (
        <p class="mt-3 border-l-2 border-line pl-3 text-sm text-muted">
          <span class="label mr-1.5">The hard part</span>{hardPart}
        </p>
      )}

      {size === "lead" && metrics.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {metrics.map((m) => (
            <li class="rounded-md bg-paper px-2 py-1 font-mono text-xs text-muted">{m}</li>
          ))}
        </ul>
      )}

      <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-4 text-xs">
        <span class="label">{period}</span>
        {size !== "normal" && <span class="font-mono text-faint">{stack.slice(0, 4).join(" / ")}</span>}
        {/* Inner links sit above the tile's stretched link. */}
        <span class="relative z-10 ml-auto flex gap-4">
          {demo && <a href={demo} class="text-accent hover:underline">Live ↗</a>}
          {repo && <a href={repo} class="text-accent hover:underline">Code ↗</a>}
        </span>
      </div>
    </div>

    {size === "lead" && chart && (
      <MacroChart {...chart} class="md:w-[46%] md:shrink-0 md:self-center" />
    )}
  </div>
</Tile>
