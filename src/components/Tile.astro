---
// One cell of the mosaic. Spans are desktop values on a 6-column grid;
// tablets get 2 columns (anything wider than 3 goes full-width), phones one.
// `label` is the small mono heading every tile carries so the page reads as
// one system rather than a pile of boxes.
interface Props {
  cols?: 1 | 2 | 3 | 4 | 6;
  rows?: 1 | 2;
  label?: string;
  href?: string;
  id?: string;
  class?: string;
}

const { cols = 2, rows = 1, label, href, id, class: extra = "" } = Astro.props;

const colClass = {
  1: "lg:col-span-1",
  2: "lg:col-span-2",
  3: "lg:col-span-3",
  4: "lg:col-span-4",
  6: "lg:col-span-6",
}[cols];
const rowClass = rows === 2 ? "lg:row-span-2" : "";
const tabletClass = cols >= 3 ? "sm:col-span-2" : "sm:col-span-1";
---

<div
  id={id}
  class:list={["tile", tabletClass, colClass, rowClass, href && "tile-link", extra]}
>
  {label && (
    <p class="label mb-3">
      {href ? <a href={href} class="stretched-link">{label}</a> : label}
    </p>
  )}
  <slot />
</div>
