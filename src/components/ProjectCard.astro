---
import type { CollectionEntry } from "astro:content";
import StatusPill from "./StatusPill.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, blurb, period, stack, status, hardPart, metrics, repo, demo } = project.data;
const href = `/projects/${project.id}`;
---

<article class="group border-t border-line py-7">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <h3 class="text-[17px] font-semibold tracking-tight">
      <a href={href} class="transition-colors group-hover:text-accent">
        {title}<span class="sr-only"> — case study</span>
      </a>
    </h3>
    <StatusPill status={status} />
    <span class="label ml-auto">{period}</span>
  </div>

  <p class="mt-2.5 text-muted">{blurb}</p>

  {hardPart && (
    <p class="mt-3.5 border-l-2 border-line pl-3.5 text-sm text-muted">
      <span class="label mr-1.5">The hard part</span>
      {hardPart}
    </p>
  )}

  {metrics.length > 0 && (
    <ul class="mt-3.5 flex flex-wrap gap-2">
      {metrics.map((metric) => (
        <li class="rounded-md bg-surface px-2 py-1 font-mono text-xs text-muted">{metric}</li>
      ))}
    </ul>
  )}

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
    <span class="font-mono text-faint">{stack.join(" / ")}</span>
    <span class="ml-auto flex gap-4">
      {demo && <a href={demo} class="text-accent hover:underline">Live ↗</a>}
      {repo && <a href={repo} class="text-accent hover:underline">Code ↗</a>}
      <a href={href} class="text-accent hover:underline">Read →</a>
    </span>
  </div>
</article>
