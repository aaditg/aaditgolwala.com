---
interface Props {
  number: string;
  title: string;
  lede?: string;
}
const { number, title, lede } = Astro.props;
---

{/* Each section opens on a full rule with its number on it, so the page reads
    as numbered chapters rather than one long scroll. */}
<header class="mb-10 border-t-2 border-ink pt-5">
  <p class="label">{number}</p>
  <h2 class="display text-heading mt-3">{title}</h2>
  {lede && <p class="mt-3 max-w-prose text-muted">{lede}</p>}
</header>
