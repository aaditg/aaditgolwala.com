---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site, nav, links } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
// Regenerate with `node scripts/og.mjs` when the name or tagline changes.
const ogImage = new URL("/og.png", Astro.site ?? site.url);
const updated = new Date();

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.tagline,
  affiliation: { "@type": "CollegeOrUniversity", name: "Purdue University" },
  sameAs: [links.github, links.linkedin],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* Structured data so search results show the name, role and profile
        links as one entity rather than guessing from page text. */}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    {/* Must run before first paint, or a visitor who chose a theme sees the
        other one flash first. `is:inline` keeps it out of the bundle. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>
  </head>

  <body class="bg-paper text-ink font-sans text-[15px] leading-relaxed antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-line focus:bg-paper focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-2xl items-center justify-between gap-6 px-6">
        <a href="/" class="font-medium tracking-tight hover:text-accent">{site.name}</a>
        <div class="flex items-center gap-5">
          {/* Hidden on phones: the full name plus four items does not fit at
              375px without truncating one of them, and the site is a single
              scroll anyway. The Writing heading on the homepage links to
              /writing so that page stays reachable without this. */}
          <nav class="hidden gap-5 text-sm text-muted sm:flex">
            {nav.map((item) => (
              <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
            ))}
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-2xl px-6">
      <slot />
    </main>

    <footer class="mx-auto mt-28 max-w-2xl border-t border-line px-6 py-10">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={`mailto:${site.email}`} class="text-muted transition-colors hover:text-ink">Email</a>
        <a href={links.github} class="text-muted transition-colors hover:text-ink">GitHub</a>
        <a href={links.linkedin} class="text-muted transition-colors hover:text-ink">LinkedIn</a>
        {site.resume && (
          <a href={site.resume} class="text-muted transition-colors hover:text-ink">Résumé</a>
        )}
      </div>
      <p class="label mt-5">
        Updated <time datetime={updated.toISOString()}>
          {updated.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
        </time> · Built with Astro, served from Cloudflare
      </p>
    </footer>
  </body>
</html>
